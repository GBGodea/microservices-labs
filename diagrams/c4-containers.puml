@startuml c4-containers
!pragma layout smetana
!include <C4/C4_Container>
title C4 — C2: приложения и взаимодействия (хранилища — отдельный вид c4-data)
LAYOUT_TOP_DOWN()

Person(rider, "Пользователь", "Арендует самокат")
Person(operator, "Оператор", "Управляет парком и политиками через административный клиент")
System_Ext(scooter, "Бортовая система самоката", "GPS, heartbeat, замок, подтверждения команд")
System_Ext(psp, "Платёжный провайдер", "Авторизация, списание, возврат, webhook")

System_Boundary(platform, "Платформа аренды самокатов") {
  Container(app, "Мобильное приложение", "iOS / Android", "Карта, управление поездкой, история и статус оплаты")
  Container(gateway, "API Gateway", "HTTPS reverse proxy", "Маршрутизация, проверка токенов, квоты и отдельные пулы сценариев")
  Container(user, "User Service", "REST API", "Пользователи, идентификация, право старта")
  Container(discovery, "Discovery Service", "REST API + Kafka consumer", "Поиск по собственной геопроекции без RPC fan-out")
  Container(trip, "Trip Service", "REST API + durable workers", "Trip, жизненный цикл и saga; завершение независимо от платежей")
  Container(fleet, "Fleet Service", "REST API + MQTT workers", "Scooter, исключительный lease, команды и сверка")
  Container(telemetry, "Telemetry Service", "MQTT ingestion + workers", "Location, валидация и история измерений")
  Container(pricing, "Pricing Service", "REST API", "Tariff, неизменяемые версии, котировки и расчёт")
  Container(geo, "Geofence Service", "REST API + geo engine", "Geofence, проверки, версии политик и свидетельства")
  Container(billing, "Billing Service", "REST API + workers", "Payment, Fine, финансовый учёт и ACL провайдера")
  ContainerQueue(bus, "Доменные события", "Apache Kafka", "At least once; outbox/inbox; партиции по агрегату; DLQ")
  ContainerQueue(mqtt, "Канал устройств", "MQTT broker", "Аутентифицированные подключения; команды, ACK и телеметрия")
}

Rel(rider, app, "Ищет и арендует")
Rel(app, gateway, "Вызывает API и читает статус операции", "HTTPS/REST")
Rel(operator, gateway, "Вызывает административные API", "HTTPS/REST")
Rel(gateway, user, "Профиль и вход", "REST")
Rel(gateway, discovery, "Поиск и карта", "REST")
Rel(gateway, trip, "Старт, статус, завершение, история", "REST")
Rel(gateway, billing, "Платежи, штрафы и обращения", "REST")
Rel(gateway, fleet, "Управление парком", "REST, operator")
Rel(gateway, pricing, "Управление тарифами", "REST, operator")
Rel(gateway, geo, "Управление зонами", "REST, operator")
Rel(trip, user, "Проверяет право нового старта", "REST")
Rel(trip, fleet, "Захватывает ресурс, запрашивает замок и результат", "REST")
Rel(trip, pricing, "Получает котировку/snapshot", "REST")
Rel(trip, geo, "Проверяет старт и парковку", "REST")
Rel(trip, billing, "Запрашивает/отменяет авторизацию при старте", "REST")
Rel(billing, pricing, "Считает итог по snapshot; при сбое ожидает", "REST")
Rel(billing, psp, "Авторизует, списывает, возвращает, сверяет", "HTTPS")
Rel(psp, billing, "Передаёт платёжный статус", "Signed HTTPS webhook")
BiRel(fleet, mqtt, "Отправляет команды; принимает результат устройства", "MQTT")
Rel(scooter, mqtt, "Публикует GPS, heartbeat и результаты команд", "MQTT/TLS")
Rel(mqtt, scooter, "Доставляет команды с ID и сроком", "MQTT/TLS")
Rel(mqtt, telemetry, "Доставляет измерения", "MQTT")
BiRel(user, bus, "Публикует доступ; читает финансовые статусы", "Kafka")
BiRel(fleet, bus, "Публикует доступность/команды; читает измерения", "Kafka")
Rel(telemetry, bus, "Публикует LocationObserved", "Kafka")
Rel(bus, discovery, "Доставляет доступность, координаты, тарифы и зоны", "Kafka")
BiRel(trip, bus, "Публикует TripEnded; читает команды/доступ/расчёты", "Kafka")
Rel(pricing, bus, "Публикует TariffVersionPublished", "Kafka")
BiRel(geo, bus, "Публикует версии зон; читает координаты", "Kafka")
BiRel(billing, bus, "Читает TripEnded; публикует расчёты и штрафы", "Kafka")

SHOW_LEGEND()
@enduml
