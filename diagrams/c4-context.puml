@startuml c4-context
!pragma layout smetana
!include <C4/C4_Context>
title C4 — C1: окружение платформы аренды самокатов
LAYOUT_LEFT_RIGHT()

Person(rider, "Пользователь", "Ищет самокат, начинает и завершает поездку, фотографирует парковку и повреждения, оплачивает и обжалует штрафы")
Person(operator, "Оператор парка", "Управляет техническим состоянием, зонами и тарифами; разбирает спорные операции, просматривает фотофиксацию (с аудитом)")
Person(devops, "Команда DevOps", "Эксплуатирует платформу, обеспечивает мониторинг и восстановление")
System(platform, "Платформа аренды самокатов", "Управляет пользователями, парком, арендой, правилами, расчётами и фотофиксацией")
System_Ext(scooter, "Бортовая система самоката", "Передаёт измерения, выполняет и подтверждает команды замка")
System_Ext(psp, "Платёжный провайдер (PSP)", "Авторизация, списание, возврат и подтверждение результата")
System_Ext(sms, "SMS-шлюз", "Доставляет одноразовые коды входа (OTP)")
System_Ext(idp, "Корпоративный OIDC IdP", "Вход операторов с MFA; выдаёт JWT с roles[] и cityIds[]")

Rel(rider, platform, "Арендует самокат, загружает фото, получает историю поездок и платежей")
Rel(operator, platform, "Управляет парком и политиками, разбирает споры по фото")
Rel(devops, platform, "Развёртывает, наблюдает, восстанавливает")
Rel(platform, scooter, "Запрашивает изменение и сверку состояния замка")
Rel(scooter, platform, "Передаёт телеметрию и результат команд")
Rel(platform, psp, "Авторизует, списывает, возвращает и сверяет средства")
Rel(psp, platform, "Сообщает подтверждённые статусы платежей")
Rel(platform, sms, "Отправляет OTP-код для входа")
Rel(sms, rider, "Доставляет OTP-код", "SMS")
Rel(operator, idp, "Входит с MFA", "OIDC")
Rel(platform, idp, "Проверяет JWT операторов", "JWKS")

SHOW_LEGEND()
@enduml
