@startuml c3-trip-saga-worker
!pragma layout smetana
!include <C4/C4_Component>
title C4 — C3: Trip Saga Worker (Trip Service)
LAYOUT_TOP_DOWN()

ContainerQueue(kafka, "Доменные события", "Apache Kafka", "fleet.device-command.v1, billing.payment-status.v1, billing.fine.v1, user.access.v1, photo.status.v1")

Container_Boundary(trip_worker, "Trip Saga Worker") {
  Component(scheduler, "Scheduler", "Spring @Scheduled", "Выборка готовых шагов FOR UPDATE SKIP LOCKED; возврат просроченных захватов; партиции и архив")
  Component(cmd_consumer, "Device Command Consumer", "Spring Kafka", "DeviceCommandUpdated → результат шага, будит ожидающий шаг")
  Component(evt_consumer, "Domain Event Consumers", "Spring Kafka", "UserAccessChanged, PaymentStatusChanged, Fine*, Photo* → проекции")
  Component(inbox, "Inbox / Dedup", "Spring JDBC", "inbox_message(consumer_group, event_id) в транзакции обработки")
  Component(executor, "Saga Step Executor", "Kotlin", "Диспетчер шагов, дедлайны, backoff + jitter, DEAD → разбор")
  Component(start_steps, "Start Saga Steps", "Kotlin", "eligibility → scooter → geo start → quote → lease → authorize (опрос GET) → UNLOCK → ACTIVE")
  Component(finish_steps, "Finish Saga Steps", "Kotlin", "measurement → geo finish → LOCK → ENDED + TripEnded → release")
  Component(comp, "Compensation & Reconciliation", "Kotlin", "release lease (409 LOCK_NOT_CONFIRMED → ждать reconcileCommandId), cancel hold, QUERY_STATE, RECONCILE_PHOTO, RECONCILING, trip_review")
  Component(domain, "Trip State Machine & Policies", "Kotlin, domain", "Переходы, проверка фото, часы устройства, finishRequestedAt")
  Component(repo, "Trip Repository", "Spring JDBC", "trip, trip_operation, saga_step, trip_transition, проекции; version-check")
  Component(outbox, "Outbox Writer", "Spring JDBC", "outbox_event TripEnded в транзакции ENDED")
  Component(fleet_client, "Fleet Client", "WebClient + Resilience4j", "Тайм-ауты 300–500 мс, retry по commandId (последний байт = байту leaseId, бакет cityId), circuit breaker; сверка: GET commands/{id}?leaseId=, GET leases/{id}")
  Component(billing_client, "Billing Client", "WebClient + Resilience4j", "POST авторизации — 4 с (PSP в Billing — 3 с), опрос GET — 300 мс, cancel — 3 с; operationKey, CB; тайм-аут = исход неизвестен")
  Component(check_clients, "Check Clients", "WebClient + Resilience4j", "User, Geofence, Pricing, Photo: тайм-ауты 300–500 мс (Geofence — 400 мс), CB, bulkhead; eligibility — fail-closed; проверка JWS котировки по signing-keys Pricing (кеш 5 мин)")
}

ContainerDb(trip_db, "Trip DB", "PostgreSQL primary", "Состояние saga, проекции, outbox/inbox")
Container(outbox_cdc, "Outbox CDC", "Kafka Connect + Debezium", "outbox_event → trip.lifecycle.v1")
Container(fleet_api, "Fleet API", "Kotlin, Spring Boot", "scooter, leases, commands, release")
Container(billing_api, "Billing API", "Kotlin, Spring Boot", "payment-authorizations")
Container(user_api, "User API", "Kotlin, Spring Boot", "rental-eligibility")
Container(geo_api, "Geofence API", "Kotlin, Spring Boot, JTS", "geo-checks")
Container(pricing_api, "Pricing API", "Kotlin, Spring Boot", "quotes, signing-keys")
ContainerDb(archive, "Archive Store", "S3-совместимое (платформа)", "Parquet-архив партиций > 13 мес.")
Container(photo_api, "Photo API", "Kotlin, Spring Boot", "GET /internal/v1/photos/{id}")

Rel(kafka, cmd_consumer, "fleet.device-command.v1", "Kafka, group trip-saga-worker")
Rel(kafka, evt_consumer, "access, payment-status, fine, photo.status", "Kafka, group trip-saga-worker")
Rel(cmd_consumer, inbox, "Дедуп event_id")
Rel(evt_consumer, inbox, "Дедуп event_id")
Rel(inbox, repo, "inbox_message в той же транзакции")
Rel(cmd_consumer, repo, "Результат команды, next_run_at = now()")
Rel(evt_consumer, repo, "Проекции, trip_review")
Rel(scheduler, repo, "Захват пачки шагов")
Rel(scheduler, executor, "Шаги RUNNING")
Rel(executor, start_steps, "Шаги старта")
Rel(executor, finish_steps, "Шаги завершения")
Rel(executor, comp, "FAILED / дедлайн")
Rel(executor, domain, "Проверка перехода")
Rel(evt_consumer, domain, "Владелец фото, версии")
Rel(executor, repo, "Результат шага + следующий шаг (одна транзакция)")
Rel(finish_steps, outbox, "TripEnded")
Rel(outbox, trip_db, "INSERT outbox_event в транзакции ENDED", "SQL")
Rel(start_steps, check_clients, "eligibility, geo start, quote + проверка подписи")
Rel(start_steps, fleet_client, "scooter, lease, UNLOCK")
Rel(start_steps, billing_client, "authorize, опрос GET статуса")
Rel(finish_steps, check_clients, "geo finish")
Rel(finish_steps, fleet_client, "scooter, LOCK, release")
Rel(comp, fleet_client, "release, QUERY_STATE, GET command?leaseId, GET lease")
Rel(comp, billing_client, "cancel")
Rel(comp, check_clients, "GET photo (RECONCILE_PHOTO)")
Rel(repo, trip_db, "Транзакции", "SQL, PgBouncer")
Rel(outbox_cdc, trip_db, "WAL outbox_event", "logical replication")
Rel(fleet_client, fleet_api, "/internal/v1/scooters, leases, commands", "HTTPS/JSON, mTLS")
Rel(billing_client, billing_api, "/internal/v1/payment-authorizations", "HTTPS/JSON, mTLS")
Rel(check_clients, user_api, "rental-eligibility", "HTTPS/JSON, mTLS")
Rel(check_clients, geo_api, "geo-checks/start|finish; GET geo-checks/{id} — сверка для разбора", "HTTPS/JSON, mTLS")
Rel(check_clients, pricing_api, "quotes, signing-keys", "HTTPS/JSON, mTLS")
Rel(scheduler, archive, "Parquet-выгрузка партиций > 13 мес.", "S3 API")
Rel(check_clients, photo_api, "photos/{id}", "HTTPS/JSON, mTLS")

SHOW_LEGEND()
@enduml
